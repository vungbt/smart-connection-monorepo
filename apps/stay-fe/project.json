{
  "name": "stay-fe",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/stay-fe",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/stay-fe"
      },
      "configurations": {
        "development": {
          "outputPath": "apps/stay-fe"
        },
        "production": {
          "outputPath": "dist/apps/stay-fe"
        }
      }
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "stay-fe:build",
        "dev": true
      },
      "configurations": {
        "development": {
          "buildTarget": "stay-fe:build:development",
          "dev": true
        },
        "production": {
          "buildTarget": "stay-fe:build:production",
          "dev": false
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "maxWarnings": -1,
        "lintFilePatterns": ["apps/stay-fe/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --write \"apps/stay-fe/**/*.{ts,tsx,js,jsx,json,css,scss,md}\""
      }
    },
    "storybook": {
      "executor": "@nx/storybook:storybook",
      "options": {
        "configDir": "apps/stay-fe/.storybook",
        "browserTarget": "stay-fe:build",
        "compodoc": false,
        "compodocArgs": [],
        "tsConfig": "apps/stay-fe/tsconfig.json"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@nx/storybook:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "configDir": "apps/stay-fe/.storybook",
        "outputDir": "dist/storybook/stay-fe",
        "outputPath": "dist/storybook/stay-fe",
        "compodoc": false,
        "compodocArgs": [],
        "tsConfig": "apps/stay-fe/tsconfig.json"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    }
  },
  "tags": []
}
