{
  "name": "@smart-connection-monorepo/sso-api",
  "version": "0.0.1",
  "private": true,
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts, json",
    "ignore": [
      "src/public"
    ],
    "exec": "ts-node -r tsconfig-paths/register ./src/main.ts"
  },
  "_moduleAliases": {
    "@": "dist/apps/sso-api/src",
    "@/routers": "dist/apps/sso-api/src/routes",
    "@/services": "dist/apps/sso-api/src/services",
    "@/controllers": "dist/apps/sso-api/src/controllers",
    "@/utils": "dist/apps/sso-api/src/utils",
    "@/middlewares": "dist/apps/sso-api/src/middlewares",
    "@/types": "dist/apps/sso-api/src/types",
    "@/modules": "dist/apps/sso-api/src/modules",
    "@/sequelize": "dist/apps/sso-api/src/sequelize",
    "@/locale": "dist/apps/sso-api/src/locale",
    "@/configs": "dist/apps/sso-api/src/configs",
    "@/models": "dist/apps/sso-api/src/models"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-fns": "^3.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.3.0",
    "i18next": "25.1.3",
    "i18next-http-middleware": "^3.7.4",
    "i18next-node-fs-backend": "^2.1.3",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "rotating-file-stream": "^3.2.1",
    "sequelize": "^6.37.1",
    "ts-custom-error": "^3.3.1",
    "tslib": "^2.3.0",
    "validatorjs": "^3.22.1",
    "winston": "^3.11.0",
    "bcryptjs": "2.4.3",
    "umzug": "^3.8.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/body-parser": "^1.19.5",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/i18next-node-fs-backend": "^2.1.4",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/lodash": "^4.14.202",
    "@types/morgan": "^1.9.9",
    "@types/node": "~18.7.1",
    "@types/validatorjs": "^3.15.5",
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0"
  }
}
