{
  "name": "@smart-connection-monorepo/stay-api",
  "version": "0.0.1",
  "private": true,
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts, json",
    "ignore": [
      "src/public"
    ],
    "exec": "ts-node -r tsconfig-paths/register ./src/main.ts"
  },
  "_moduleAliases": {
    "@": "./src",
    "@/routers": "./src/routes",
    "@/services": "./src/services",
    "@/controllers": "./src/controllers",
    "@/utils": "./src/utils",
    "@/middlewares": "./src/middlewares",
    "@/types": "./src/types",
    "@/modules": "./src/modules",
    "@/sequelize": "./src/sequelize",
    "@/locale": "./src/locale",
    "@/configs": "./src/configs",
    "@/models": "./src/models"
  }
}
