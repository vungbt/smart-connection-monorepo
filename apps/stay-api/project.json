{
  "name": "stay-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/stay-api",
  "projectType": "application",
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["rm -rf dist/apps/stay-api", "rm -rf apps/stay-api/dist"]
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "production",
      "options": {
        "cwd": ".",
        "commands": [
          "rimraf dist/apps/stay-api",
          "tsc -p apps/stay-api/tsconfig.json --outDir dist/apps/stay-api",
          "cp -r apps/stay-api/src/assets dist/apps/stay-api/src/ 2>/dev/null || :",
          "cp apps/stay-api/package.json dist/apps/stay-api/ 2>/dev/null || :"
        ],
        "parallel": false
      },
      "configurations": {
        "development": {
          "commands": [
            "rimraf dist/apps/stay-api",
            "tsc -p apps/stay-api/tsconfig.json --outDir dist/apps/stay-api --sourceMap",
            "cp -r apps/stay-api/src/assets dist/apps/stay-api/src/ 2>/dev/null || :",
            "cp apps/stay-api/package.json dist/apps/stay-api/ 2>/dev/null || :"
          ]
        },
        "production": {
          "commands": [
            "rimraf dist/apps/stay-api",
            "tsc -p apps/stay-api/tsconfig.json --outDir dist/apps/stay-api",
            "cp -r apps/stay-api/src/assets dist/apps/stay-api/src/ 2>/dev/null || :",
            "cp apps/stay-api/package.prod.json dist/apps/stay-api/package.json 2>/dev/null || :"
          ]
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "stay-api:build",
        "watch": true,
        "buildTargetOptions": {
          "outputPath": "dist/apps/stay-api",
          "outputFileName": "src/main.js"
        }
      },
      "configurations": {
        "development": {
          "buildTarget": "stay-api:build:development"
        },
        "production": {
          "buildTarget": "stay-api:build:production"
        }
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cross-env NODE_ENV=development nodemon",
        "cwd": "apps/stay-api"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/stay-api/**/*.{ts,tsx,js,jsx}"],
        "maxWarnings": -1
      }
    },
    "create-migration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ./scripts/create-migration.js --name {args.name}",
        "cwd": "apps/stay-api"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sequelize db:migrate --env development",
        "cwd": "apps/stay-api"
      }
    },
    "migrate:undo": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sequelize db:migrate:undo --env development",
        "cwd": "apps/stay-api"
      }
    },
    "migrate:undo:all": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sequelize db:migrate:undo:all --env development",
        "cwd": "apps/stay-api"
      }
    },
    "create:migration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sequelize migration:generate --name {args.name} --env development",
        "cwd": "apps/stay-api"
      }
    }
  },
  "tags": []
}
